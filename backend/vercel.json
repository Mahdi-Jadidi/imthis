{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/lifecycle",
      "schedule": "5 3 * * *"
    }
  ]
}
