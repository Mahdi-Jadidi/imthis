# Copy this file to .env.local for host development.
# Copy this file to .env.docker for Docker Compose, then change
# localhost URLs to Docker service names:
#   DATABASE_URL: localhost -> postgres
#   REDIS_URL: localhost -> redis
#   MINIO_ENDPOINT: localhost -> minio

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://dropcv_user:your_password@localhost:5432/dropcv
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=imthis-files
ANTHROPIC_API_KEY=your_claude_api_key
AI_SITE_GENERATION_ENABLED=false
SITE_GENERATION_API_URL=
SITE_GENERATION_API_KEY=
FRONTEND_URL=http://localhost:8080
# Leave empty for a host-only cookie. Set only for intentional subdomain sharing.
COOKIE_DOMAIN=
# Number of trusted reverse proxies in front of Fastify.
TRUST_PROXY=1
PUBLIC_SITE_PATH_PREFIX=/site
PUBLIC_SITE_URL_TEMPLATE=https://{slug}.imthis.site/
# Comma-separated email addresses that may use /admin.html.
ADMIN_EMAILS=you@example.com
# Required by the Vercel Cron endpoint that runs trial expiration and renewal jobs.
CRON_SECRET=replace-with-a-long-random-secret
# Card-to-card instructions shown only to authenticated customers after they create a payment request.
MANUAL_PAYMENT_CARD_NUMBER=0000000000000000
MANUAL_PAYMENT_CARD_HOLDER=Your Name
MANUAL_PAYMENT_BANK_NAME=Bank name
# Optional: set to a trusted http(s) endpoint that returns country/city JSON for analytics.
ANALYTICS_GEO_LOOKUP_URL=
SMTP_FROM=I'm This <noreply@imthis.site>
